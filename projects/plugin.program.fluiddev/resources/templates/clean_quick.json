{
    "id": "clean_quick",
    "name": "Code Cleaning - Quick",
    "description": "Fast code cleanup with safe defaults",
    "version": "1.0",
    "module": "code_cleaner",
    "mode": "quick",
    "options": {
        "remove_comments": false,
        "remove_docstrings": false,
        "remove_unused_imports": true,
        "normalize_whitespace": true,
        "fix_line_endings": true,
        "create_backup": true
    },
    "output": {
        "format": "summary",
        "save_report": true,
        "show_notification": true
    }
}
