{
    "id": "m3u_converter_fulldev",
    "name": "M3U Converter - FullDev",
    "description": "Select specific M3U files to convert",
    "version": "1.0",
    "module": "m3u_converter",
    "mode": "fulldev",
    "options": {
        "input_directory": "{profile_path}/playlists",
        "output_directory": "{profile_path}/youtube",
        "recursive_scan": false,
        "file_selection": "manual"
    },
    "output": {
        "format": "json",
        "show_notification": true,
        "include_metadata": true
    }
}
