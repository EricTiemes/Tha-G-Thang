    {
      "skill_id": "B7",
      "name": "error_recovery_handler",
      "class": "runtime",
      "purpose": "Detect execution errors and apply recovery strategies",
      "inputs": [
        "error_type",
        "error_context",
        "execution_state",
        "recovery_policies"
      ],
      "outputs": [
        "recovery_action",
        "updated_state",
        "error_report",
        "continuation_plan"
      ],
      "preconditions": [
        "error_detected",
        "state_snapshot_available"
      ],
      "constraints": [
        "data_integrity_preserved",
        "no_infinite_retry_loops",
        "user_notified_on_failure"
      ],
      "failure_modes": [
        "unrecoverable_error",
        "recovery_failed",
        "state_corruption"
      ],
      "invocation_pattern": "on_failure",
      "error_categories": {
        "transient": {
          "description": "Temporary failures, retry may succeed",
          "examples": [
            "network_timeout",
            "rate_limit",
            "temp_unavailable"
          ],
          "strategy": "exponential_backoff_retry"
        },
        "permanent": {
          "description": "Persistent failures requiring alternative approach",
          "examples": [
            "invalid_api_key",
            "permission_denied",
            "not_found"
          ],
          "strategy": "fallback_or_escalate"
        },
        "logic": {
          "description": "Application logic errors",
          "examples": [
            "validation_failed",
            "constraint_violation"
          ],
          "strategy": "rollback_and_notify"
        }
      },
      "recovery_strategies": {
        "retry": "Attempt same operation again",
        "fallback": "Use alternative skill or agent",
        "rollback": "Revert to previous state",
        "escalate": "Pass to human or review agent",
        "degrade": "Continue with reduced functionality"
      }
    },
