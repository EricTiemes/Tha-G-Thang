{
  "extended_builder_skills": [
    {
      "skill_id": "A6",
      "name": "free_tier_optimizer",
      "class": "builder",
      "purpose": "Optimize system configuration for free-tier AI model constraints including token limits, rate limits, and capability restrictions",
      "inputs": [
        "target_ai_model",
        "system_configuration",
        "free_tier_constraints",
        "optimization_targets"
      ],
      "outputs": [
        "optimized_configuration",
        "fallback_strategies",
        "capability_mapping"
      ],
      "preconditions": [
        "ai_model_capabilities_known",
        "free_tier_limits_documented"
      ],
      "constraints": [
        "must_preserve_core_functionality",
        "cannot_exceed_free_tier_quotas",
        "must_provide_degradation_path"
      ],
      "failure_modes": [
        "model_too_limited_for_requirements",
        "optimization_conflicts_with_requirements",
        "unknown_model_capabilities"
      ],
      "invocation_pattern": "planning",
      "optimization_strategies": {
        "prompt_compression": {
          "description": "Reduce prompt size while preserving intent",
          "use_when": "token_limits_approached",
          "techniques": [
            "summarization",
            "keyword_extraction",
            "context_pruning"
          ]
        },
        "capability_sharding": {
          "description": "Distribute tasks across multiple free-tier calls",
          "use_when": "single_call_insufficient",
          "pattern": "decompose \u2192 parallel_execute \u2192 aggregate"
        },
        "model_cascading": {
          "description": "Use multiple models with fallback chain",
          "use_when": "primary_model_unavailable",
          "chain": "primary \u2192 secondary \u2192 local_llm"
        }
      },
      "free_tier_mappings": {
        "gemini": {
          "daily_requests": 1500,
          "tokens_per_minute": 100000,
          "optimization": "aggressive_batching"
        },
        "chatgpt_4o_mini": {
          "daily_requests": 200,
          "tokens_per_minute": 200000,
          "optimization": "prompt_caching"
        },
        "llama_local": {
          "constraints": "device_dependent",
          "optimization": "quantization_aware"
        }
      }
    },
    {
      "skill_id": "A7",
      "name": "context_window_manager",
      "class": "builder",
      "purpose": "Design context management strategies for limited context windows in free-tier AI models",
      "inputs": [
        "context_window_size",
        "conversation_history",
        "priority_context_items",
        "compression_ratio"
      ],
      "outputs": [
        "optimized_context_window",
        "eviction_strategy",
        "context_summary"
      ],
      "preconditions": [
        "context_items_prioritized",
        "window_size_known"
      ],
      "constraints": [
        "critical_context_preserved",
        "compression_reversible",
        "performance_impact_minimal"
      ],
      "failure_modes": [
        "context_too_large_even_compressed",
        "critical_context_evicted",
        "compression_corruption"
      ],
      "invocation_pattern": "mid_execution",
      "context_strategies": {
        "sliding_window": {
          "description": "Keep only recent N messages",
          "use_when": "streaming_conversation",
          "window_size": "model_dependent"
        },
        "hierarchical_summarization": {
          "description": "Summarize older context, keep recent verbatim",
          "use_when": "long_conversation_history",
          "levels": [
            "full",
            "summary",
            "key_points"
          ]
        },
        "semantic_retrieval": {
          "description": "Store full context externally, retrieve relevant chunks",
          "use_when": "very_large_context_required",
          "requires": "vector_store"
        }
      },
      "eviction_policies": {
        "priority_based": "Keep high-priority items, evict low",
        "recency_based": "Keep recent, evict old",
        "relevance_based": "Keep relevant to current query, evict unrelated"
      }
    },
    {
      "skill_id": "A8",
      "name": "output_schema_designer",
      "class": "builder",
      "purpose": "Design JSON schemas and output formats optimized for free-tier AI model generation",
      "inputs": [
        "required_output_structure",
        "ai_model_capabilities",
        "complexity_constraints",
        "validation_requirements"
      ],
      "outputs": [
        "optimized_schema",
        "validation_rules",
        "example_outputs",
        "fallback_formats"
      ],
      "preconditions": [
        "output_requirements_defined",
        "model_capabilities_known"
      ],
      "constraints": [
        "schema_must_validate",
        "model_can_generate_compliant_output",
        "fallback_for_partial_outputs"
      ],
      "failure_modes": [
        "model_cannot_generate_valid_schema",
        "schema_too_complex_for_model",
        "validation_always_fails"
      ],
      "invocation_pattern": "post_execution",
      "schema_optimization": {
        "field_limiting": {
          "description": "Reduce required fields to minimum",
          "use_when": "model_struggles_with_complexity",
          "approach": "required_only \u2192 optional_fields \u2192 nested_objects"
        },
        "type_simplification": {
          "description": "Use simpler types (string vs enum)",
          "use_when": "model_confused_by_constraints",
          "mapping": "enum\u2192string, union\u2192string, nested\u2192flat"
        },
        "example_enrichment": {
          "description": "Add more examples to prompt",
          "use_when": "model_format_inconsistent",
          "technique": "few_shot_with_schema"
        }
      },
      "schema_tiers": {
        "strict": "Full validation, all fields required",
        "flexible": "Partial validation, optional fields allowed",
        "minimal": "Basic structure only, content flexible"
      }
    },
    {
      "skill_id": "A10",
      "name": "skill_registration_manager",
      "class": "builder",
      "purpose": "Manage registration of new skills with validation, dependency resolution, and integration into skill_registry",
      "inputs": [
        "skill_definition",
        "skill_registry_current",
        "dependency_graph",
        "validation_rules"
